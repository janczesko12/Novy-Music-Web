# OAuth client created in Google Cloud Console (never commit real values)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Must exactly match a URI listed under the OAuth client's Authorized redirect URIs
GOOGLE_REDIRECT_URI=https://music.novydev.pl/api/auth/google/callback
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Existing Basic Auth password for the private site
SITE_PASSWORD=replace-with-a-strong-password
